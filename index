        <h3 class="moment-title">월세 <span>10원</span> 주연 캐스팅</h3>
        <p class="moment-desc">
          10주년을 맞은 2026년 12월, 다음 10년의 역사를 함께 써 내려갈 새로운 주인공(대표님)을 10원에 초대합니다.
        </p>
      </article>
    </div>

    <div class="film-strip-bar bottom" aria-hidden="true">
      <div class="film-sprocket-track"></div>
    </div>
  </div>
</section>

<!-- SEC 5: TRUST & FOOTER -->
<footer class="trust-section">
  <p class="trust-quote">
    “지난 10년간 수많은 비즈니스의 시작과 성장을 함께했습니다.<br>
    비용 걱정 없이 오직 비즈니스에만 집중할 수 있도록, 12월의 주인공을 10원에 모십니다.”
  </p>
  <p class="legal-note">
    ※ 본 프로모션은 당사 기준 및 계약 조건에 따라 적용되며, 상세 혜택 및 잔여 호실 안내 등은 전담 매니저 해피콜을 통해 확정됩니다.
  </p>
</footer>

<!-- COMPLETION MODAL -->
<div class="modal-backdrop" id="complete-modal">
  <div class="modal-box">
    <h3>🎟️ VIP 티켓 등록 완료!</h3>
    <p id="modal-msg">
      티켓 번호가 정상적으로 귀속되었습니다.<br>
      입력하신 연락처로 티켓 안내 문자가 발송되며, 전담 매니저가 순차적으로 연락드릴 예정입니다.
    </p>
    <button type="button" class="modal-close" onclick="closeModal()">확인</button>
  </div>
</div>

<script>
  // 1. Office Door Selection & 1.5s Dramatic Spotlight Animation
  const seatButtons = document.querySelectorAll('.seat-btn');
  const statusBanner = document.getElementById('status-banner');
  const resultSection = document.getElementById('result-section');
  const ticketSeatEl = document.getElementById('ticket-seat');
  const ticketSerialEl = document.getElementById('ticket-serial');
  let isAnimating = false;
  let hasWon = false;

  seatButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (isAnimating || hasWon) return;
      isAnimating = true;

      const selectedSeatLabel = btn.querySelector('.seat-label').textContent;
      statusBanner.textContent = "✨ 잔여 10원 티켓 수량 및 주인공 자격 매칭 중...";

      seatButtons.forEach(b => b.disabled = true);

      let scanIndex = 0;
      const scanInterval = setInterval(() => {
        seatButtons.forEach(b => b.classList.remove('scanning'));
        seatButtons[scanIndex % seatButtons.length].classList.add('scanning');
        scanIndex++;
      }, 140);

      setTimeout(() => {
        clearInterval(scanInterval);
        seatButtons.forEach(b => b.classList.remove('scanning'));
        btn.classList.add('winner');

        const randNum = String(Math.floor(Math.random() * 89) + 11).padStart(3, '0');
        const serial = `NO.2026-10TH-${randNum}`;

        ticketSeatEl.textContent = selectedSeatLabel;
        ticketSerialEl.textContent = serial;
        statusBanner.textContent = `🎉 [${selectedSeatLabel}] 10원 오피스 당첨! 아래에서 티켓을 확정하세요.`;

        hasWon = true;
        isAnimating = false;

        launchConfetti();
        resultSection.style.display = 'block';
        setTimeout(() => {
          resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 250);
      }, 1500);
    });
  });

  // 2. Midnight Countdown Timer
  function updateMidnightTimer() {
    const now = new Date();
    const midnight = new Date(now);
    midnight.setHours(24, 0, 0, 0);
    const diff = midnight - now;

    const hours = String(Math.floor((diff / (1000 * 60 * 60)) % 24)).padStart(2, '0');
    const minutes = String(Math.floor((diff / 1000 / 60) % 60)).padStart(2, '0');
    const seconds = String(Math.floor((diff / 1000) % 60)).padStart(2, '0');

    document.getElementById('countdown-timer').textContent = `${hours}:${minutes}:${seconds}`;
    document.getElementById('hero-clock-h').textContent = hours;
    document.getElementById('hero-clock-m').textContent = minutes;
    document.getElementById('hero-clock-s').textContent = seconds;
  }
  setInterval(updateMidnightTimer, 1000);
  updateMidnightTimer();

  // 3. Lead Form Submission -> Google Sheets 연동
  const GOOGLE_SCRIPT_URL = "여기에_복사한_웹앱_URL을_붙여넣으세요";
  const leadForm = document.getElementById('lead-form');
  const submitBtn = leadForm.querySelector('.submit-btn');
  const modal = document.getElementById('complete-modal');
  const modalMsg = document.getElementById('modal-msg');

  leadForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    const name = document.getElementById('company-name').value.trim();
    const phone = document.getElementById('phone-number').value.trim();
    const headcount = document.querySelector('input[name="headcount"]:checked').value;
    const seat = ticketSeatEl.textContent;
    const serial = ticketSerialEl.textContent;

    submitBtn.disabled = true;
    submitBtn.textContent = "티켓 등록 및 발송 중...";

    try {
      if (GOOGLE_SCRIPT_URL.startsWith("https://")) {
        await fetch(GOOGLE_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            seat: seat,
            serial: serial,
            companyName: name,
            phone: phone,
            headcount: headcount
          })
        });
      }

      modalMsg.innerHTML = `<strong>${name}</strong>님, 고유 티켓(<strong>${serial}</strong>) 등록이 완료되었습니다.<br><br>전담 매니저가 확인 후 순차적으로 연락드려 10원 입주 안내를 도와드리겠습니다.`;
      modal.style.display = 'flex';
      launchConfetti();
      leadForm.reset();
    } catch (err) {
      alert("일시적인 오류가 발생했습니다. 다시 시도해 주세요.");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "내 10원 티켓 확정하고 문자 받기";
    }
  });

  function closeModal() {
    modal.style.display = 'none';
  }

  // 4. Lightweight Gold & Red Confetti Effect
  const canvas = document.getElementById('confetti-canvas');
  const ctx = canvas.getContext('2d');
  let particles = [];

  function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  function launchConfetti() {
    const colors = ['#e5c17b', '#fef08a', '#dc2626', '#9e1b1b', '#ffffff'];
    for (let i = 0; i < 110; i++) {
      particles.push({
        x: canvas.width / 2 + (Math.random() - 0.5) * 200,
        y: canvas.height / 2,
        vx: (Math.random() - 0.5) * 16,
        vy: (Math.random() - 1) * 16 - 4,
        size: Math.random() * 8 + 4,
        color: colors[Math.floor(Math.random() * colors.length)],
        rotation: Math.random() * 360,
        rSpeed: (Math.random() - 0.5) * 10,
        gravity: 0.35,
        alpha: 1
      });
    }
    if (particles.length <= 110) animateConfetti();
  }

  function animateConfetti() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach((p, i) => {
      p.x += p.vx;
      p.y += p.vy;
      p.vy += p.gravity;
      p.rotation += p.rSpeed;
      p.alpha -= 0.008;

      ctx.save();
      ctx.globalAlpha = Math.max(p.alpha, 0);
      ctx.translate(p.x, p.y);
      ctx.rotate((p.rotation * Math.PI) / 180);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
      ctx.restore();

      if (p.alpha <= 0) particles.splice(i, 1);
    });

    if (particles.length > 0) {
      requestAnimationFrame(animateConfetti);
    }
  }
</script>

</body>
</html>
